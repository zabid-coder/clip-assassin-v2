# Clip Assassin Configuration
# Copy this file to .env and customize for your environment

# API Settings
CLIP_ASSASSIN_HOST=127.0.0.1
CLIP_ASSASSIN_PORT=8000
CLIP_ASSASSIN_DEBUG=false

# Database (optional - defaults to app data directory)
# CLIP_ASSASSIN_DB_PATH=/path/to/settings.db

# CORS Origins (comma-separated)
CLIP_ASSASSIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis for Task Queue (optional)
CLIP_ASSASSIN_REDIS_URL=redis://localhost:6379/0
CLIP_ASSASSIN_TASK_QUEUE=false

# AI Integration (optional)
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=base

# Logging
CLIP_ASSASSIN_LOG_LEVEL=INFO
# CLIP_ASSASSIN_LOG_FILE=/var/log/clip_assassin.log

# Plugin System
CLIP_ASSASSIN_PLUGIN_DIR=./plugins
CLIP_ASSASSIN_PLUGINS=false

# WebSocket Support
CLIP_ASSASSIN_WEBSOCKET=true

# Render Settings
CLIP_ASSASSIN_MAX_RENDERS=3
CLIP_ASSASSIN_RENDER_TIMEOUT=3600

# Security
CLIP_ASSASSIN_SECRET_KEY=change-this-to-a-random-secret-key-in-production
CLIP_ASSASSIN_ALLOWED_PATHS=/Users,/home,/Volumes,/mnt
